{
  "name": "haulxpress",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start:local": "npx expo start",
    "start:cache": "npx expo start -c",
    "start:fast": "EXPO_USE_EXOTIC=1 expo start --clear",
    "ts-test": "npx tsc",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest --watch --coverage=false --changedSince=origin/main",
    "lint": "eslint src && yarn tsc",
    "test:debug": "jest -o --watch --coverage=false",
    "test:final": "jest",
    "updateSnapshots": "jest -u --coverage=false",
    "fix": "npx expo install --check",
    "format": "prettier --write .",
    "doctor": "npx expo-doctor",
    "publish": "eas update",
    "login": "eas login",
    "logout": "eas logout",
    "register": "eas register",
    "whoami": "eas whoami",
    "build:ios": "eas build:ios",
    "build:android": "eas build:android",
    "build": "yarn build:ios && yarn build:android",
    "prebuild": "npx expo prebuild",
    "build:preview": "eas build -p android --profile preview",
    "upgrade-all-deb": "upgrade-interactive --latest",
    "upload:ios": "expo upload:ios",
    "upload:android": "expo upload:android",
    "upload": "yarn upload:ios && yarn upload:android"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.8.12",
    "@react-navigation/elements": "^2.9.2",
    "@react-navigation/native": "^7.1.25",
    "@react-navigation/native-stack": "^7.8.6",
    "@react-navigation/stack": "^7.6.12",
    "@reduxjs/toolkit": "^2.11.1",
    "expo": "^54.0.27",
    "expo-auth-session": "~7.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-image-picker": "~17.0.9",
    "expo-linking": "~8.0.10",
    "expo-random": "^14.0.1",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.15",
    "expo-web-browser": "~15.0.10",
    "firebase": "^12.6.0",
    "lodash": "^4.17.21",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-app-intro-slider": "^4.0.4",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-places-autocomplete": "^2.6.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "rn-placeholder": "^3.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@types/lodash": "^4.17.21",
    "@types/react": "~19.1.10",
    "@types/react-native-dotenv": "^0.2.2",
    "prettier": "^3.7.4",
    "react-native-animatable": "^1.4.0",
    "react-native-dotenv": "^3.4.11",
    "typescript": "~5.9.3"
  },
  "private": true
}
